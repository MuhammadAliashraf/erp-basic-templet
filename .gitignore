# ---------------------------------------------------------------------------
# Repository-wide ignores. Per-app rules live in client/.gitignore and
# server/.gitignore; this file is the safety net for the whole workspace.
# ---------------------------------------------------------------------------

# Dependencies & build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Secrets — never commit any of these.
#
# NOTE: client/.env IS tracked on purpose. It holds only VITE_-prefixed values,
# which are compiled into the public browser bundle and therefore cannot be
# secret by definition. Anything genuinely sensitive belongs in .env.local
# (ignored below) or in the server's environment — never in a VITE_ variable.
# ---------------------------------------------------------------------------
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Credentials & keys of any kind
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
.npmrc
.netrc
secrets.json
credentials.json
serviceAccount*.json
gha-creds-*.json

# Editors & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temp
.temp/
.tmp/
