# ---------------------------------------------------------------------------
# Enterprise Admin Template — environment contract
#
# Only `VITE_`-prefixed variables reach the browser bundle. Never place secrets
# here: everything in this file is public once the app is built.
# Copy to `.env.local` for local overrides (git-ignored).
# The schema in `src/config/env.ts` validates these at startup.
# ---------------------------------------------------------------------------

# Display name used in the shell header, document title and login screen.
VITE_APP_NAME="Enterprise Admin"

# Base URL for all HTTP calls. Use a relative path ("/api") to go through the
# dev proxy / production reverse proxy, or an absolute origin for a split host.
VITE_API_BASE_URL="/api"

# Request timeout in milliseconds.
VITE_API_TIMEOUT=30000

# "cookie"  -> httpOnly session cookies (recommended; withCredentials is on)
# "bearer"  -> access token in Authorization header, refreshed via /auth/refresh
VITE_AUTH_STRATEGY="bearer"

# Toggle the in-app mock API. When true, no network calls leave the browser and
# the template runs standalone against seeded fixtures.
VITE_ENABLE_MOCK_API=true

# Vite dev server port.
VITE_DEV_SERVER_PORT=5173

# Optional: proxy /api to a running backend during development.
# VITE_DEV_PROXY_TARGET="http://localhost:3000"
