# ---------------------------------------------------------------------------
# COMMITTED ON PURPOSE — PUBLIC VALUES ONLY.
#
# This file is tracked in git so a fresh clone runs standalone against the mock
# API with no setup. Every VITE_-prefixed value is compiled into the browser
# bundle and is therefore readable by anyone who loads the app.
#
#   NEVER put an API key, token, password or connection string in this file.
#   Local overrides go in .env.local (git-ignored). Real secrets belong to the
#   server's environment and must never carry a VITE_ prefix.
#
# Validated at startup by src/config/env.ts. See .env.example for the full
# contract and the optional variables.
# ---------------------------------------------------------------------------

VITE_APP_NAME="Enterprise Admin"
VITE_API_BASE_URL="/api"
VITE_API_TIMEOUT=30000
VITE_AUTH_STRATEGY="bearer"
VITE_ENABLE_MOCK_API=true
VITE_DEV_SERVER_PORT=5173
